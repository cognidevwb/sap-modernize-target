PROCEDURE "READ_CONTROL_TOWER" (IN company NVARCHAR(4), OUT result TABLE (ORDER_ID NVARCHAR(36), REVENUE DECIMAL(15,2), MARGIN DECIMAL(15,2)))
LANGUAGE SQLSCRIPT SQL SECURITY INVOKER READS SQL DATA AS BEGIN
 result = SELECT "ORDER_ID", "REVENUE", "MARGIN" FROM "ORDER_MARGIN" WHERE "COMPANY_CODE" = :company;
END

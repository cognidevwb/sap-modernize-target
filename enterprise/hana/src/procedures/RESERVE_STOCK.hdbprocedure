PROCEDURE "RESERVE_STOCK" (IN material NVARCHAR(36), IN plant NVARCHAR(4), IN quantity INTEGER)
LANGUAGE SQLSCRIPT SQL SECURITY INVOKER AS BEGIN
 IF :quantity <= 0 THEN SIGNAL SQL_ERROR_CODE 10001 SET MESSAGE_TEXT = 'Quantity must be positive'; END IF;
 UPDATE "STOCK_SNAPSHOT" SET "AVAILABLE" = "AVAILABLE" - :quantity, "RESERVED" = "RESERVED" + :quantity WHERE "MATERIAL_ID" = :material AND "PLANT" = :plant AND "AVAILABLE" >= :quantity;
 IF ::ROWCOUNT <> 1 THEN SIGNAL SQL_ERROR_CODE 10002 SET MESSAGE_TEXT = 'Stock unavailable'; END IF;
END

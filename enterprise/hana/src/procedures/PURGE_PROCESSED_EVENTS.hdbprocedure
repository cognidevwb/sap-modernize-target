PROCEDURE "PURGE_PROCESSED_EVENTS" (IN cutoff TIMESTAMP)
LANGUAGE SQLSCRIPT SQL SECURITY INVOKER AS BEGIN
 IF :cutoff > ADD_DAYS(CURRENT_UTCTIMESTAMP, -30) THEN SIGNAL SQL_ERROR_CODE 10003 SET MESSAGE_TEXT = 'Minimum retention is 30 days'; END IF;
 DELETE FROM "EVENT_LEDGER" WHERE "STATE" = 'PROCESSED' AND "PROCESSED_AT" < :cutoff;
END

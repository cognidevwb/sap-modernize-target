PROCEDURE "RECONCILE_ORDERS" (IN run_id NVARCHAR(36), IN expected_count INTEGER)
LANGUAGE SQLSCRIPT SQL SECURITY INVOKER AS BEGIN
 DECLARE actual_count INTEGER;
 SELECT COUNT(*) INTO actual_count FROM "ORDER_FACT" WHERE "STATUS" = 'RELEASED';
 INSERT INTO "RECONCILIATION_RESULT" VALUES (:run_id, 'ORDER_CORE', :expected_count, :actual_count, CURRENT_UTCTIMESTAMP);
END

VIEW "ORDER_MARGIN" AS SELECT o."ORDER_ID", o."COMPANY_CODE", o."STATUS", SUM(i."QUANTITY" * i."UNIT_PRICE") AS "REVENUE", SUM(i."QUANTITY" * (i."UNIT_PRICE" - i."UNIT_COST")) AS "MARGIN" FROM "ORDER_FACT" o JOIN "ORDER_ITEM_FACT" i ON i."ORDER_ID" = o."ORDER_ID" GROUP BY o."ORDER_ID", o."COMPANY_CODE", o."STATUS"

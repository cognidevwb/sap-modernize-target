FUNCTION "CUSTOMER_CASH_FORECAST" (IN company NVARCHAR(4))
RETURNS TABLE (CUSTOMER_ID NVARCHAR(36), ORDER_ID NVARCHAR(36), NET_AMOUNT DECIMAL(15,2), CUMULATIVE_EXPOSURE DECIMAL(18,2))
LANGUAGE SQLSCRIPT SQL SECURITY INVOKER AS BEGIN
 RETURN SELECT "CUSTOMER_ID", "ORDER_ID", "NET_AMOUNT",
  SUM("NET_AMOUNT") OVER (PARTITION BY "CUSTOMER_ID" ORDER BY "CREATED_AT", "ORDER_ID" ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS "CUMULATIVE_EXPOSURE"
 FROM "ORDER_FACT" WHERE "COMPANY_CODE" = :company AND "STATUS" = 'RELEASED';
END
